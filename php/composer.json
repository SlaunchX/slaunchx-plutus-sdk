{
    "name": "slaunchx/plutus-sdk",
    "description": "SlaunchX Plutus 商户 API PHP SDK (协议 SLAUNCHX-PLUTUS-API-V1, 仅传输层)",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["slaunchx", "plutus", "api", "sdk", "rsa", "hybrid-encryption"],
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SlaunchX\\Plutus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SlaunchX\\Plutus\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
